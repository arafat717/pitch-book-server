{
  "info": {
    "_postman_id": "7f9ccf1c-6a8f-4f4c-9ee3-6c1b0bf8c8d1",
    "name": "Pitch Book Booking API",
    "description": "Booking and bKash payment endpoints. Login is included only to obtain the player access token required by protected booking endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "player@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Player@123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "PASTE_USER_ID",
      "type": "string"
    },
    {
      "key": "groundId",
      "value": "PASTE_GROUND_ID",
      "type": "string"
    },
    {
      "key": "scheduleId",
      "value": "PASTE_SCHEDULE_ID",
      "type": "string"
    },
    {
      "key": "pricingRuleId",
      "value": "PASTE_PRICING_RULE_ID",
      "type": "string"
    },
    {
      "key": "slotId",
      "value": "PASTE_AVAILABLE_SLOT_ID",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "payoutId",
      "value": "PASTE_PAYOUT_ID",
      "type": "string"
    },
    {
      "key": "paymentID",
      "value": "PASTE_BKASH_PAYMENT_ID",
      "type": "string"
    },
    {
      "key": "paymentStatus",
      "value": "success",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register player",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Player One\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Player@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Verify email OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-mail"
          }
        },
        {
          "name": "Login player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh-token"
          }
        },
        {
          "name": "Google login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/google"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"newPassword\": \"NewPlayer@123\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Owner",
      "item": [
        {
          "name": "Request owner account (multipart)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "businessName",
                  "value": "Example Sports Ground",
                  "type": "text"
                },
                { "key": "licenseDoc", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/owner/owner-request"
          }
        },
        {
          "name": "My owner application (multipart)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "businessName",
                  "value": "Example Sports Ground",
                  "type": "text"
                },
                { "key": "licenseDoc", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/owner/my-owner-application"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Approve owner application",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/owner-applications/{{userId}}/approve"
          }
        },
        {
          "name": "Reject owner application",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/owner-applications/{{userId}}/reject"
          }
        }
      ]
    },
    {
      "name": "Grounds",
      "item": [
        {
          "name": "Create ground",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Sports Ground\",\n  \"address\": \"123 Main Street\",\n  \"latitude\": 23.8103,\n  \"longitude\": 90.4125,\n  \"sportTypes\": \"FOOTBALL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground/create-ground"
          }
        },
        {
          "name": "Get all grounds",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground/"
          }
        },
        {
          "name": "Get ground by ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground/{{groundId}}"
          }
        },
        {
          "name": "Update ground",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Sports Ground\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground/update-ground/{{groundId}}"
          }
        },
        {
          "name": "Add ground photos (multipart)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "photos", "type": "file", "src": "" }]
            },
            "url": "{{baseUrl}}/api/v1/ground-photo/add-ground-photo/{{groundId}}"
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create schedule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 1,\n  \"openTime\": \"09:00\",\n  \"closeTime\": \"21:00\",\n  \"slotDurationMin\": 60\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-schedule/grounds/{{groundId}}/schedules"
          }
        },
        {
          "name": "Get ground schedules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ground-schedule/grounds/{{groundId}}/schedules"
          }
        },
        {
          "name": "Update schedule",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"closeTime\": \"22:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-schedule/grounds/{{groundId}}/schedules/{{scheduleId}}"
          }
        },
        {
          "name": "Delete schedule",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground-schedule/grounds/{{groundId}}/schedules/{{scheduleId}}"
          }
        }
      ]
    },
    {
      "name": "Pricing rules",
      "item": [
        {
          "name": "Create pricing rule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayType\": \"WEEKDAY\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"18:00\",\n  \"price\": 1000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-price/{{groundId}}/pricing-rules"
          }
        },
        {
          "name": "Get pricing rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ground-price/{{groundId}}/pricing-rules"
          }
        },
        {
          "name": "Update pricing rule",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1200\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-price/{{groundId}}/pricing-rules/{{pricingRuleId}}"
          }
        },
        {
          "name": "Delete pricing rule",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground-price/{{groundId}}/pricing-rules/{{pricingRuleId}}"
          }
        }
      ]
    },
    {
      "name": "Slots",
      "item": [
        {
          "name": "Generate slots",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromDate\": \"2026-09-08\",\n  \"toDate\": \"2026-09-14\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-slots/{{groundId}}/slots/generate"
          }
        },
        {
          "name": "Reprice slots",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromDate\": \"2026-09-08\",\n  \"toDate\": \"2026-09-14\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ground-slots/{{groundId}}/slots/reprice"
          }
        },
        {
          "name": "Get slots by date",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ground-slots/{{groundId}}/slots?date=2026-09-08"
          }
        },
        {
          "name": "Block slot",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground-slots/{{groundId}}/slots/{{slotId}}/block"
          }
        },
        {
          "name": "Unblock slot",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/ground-slots/{{groundId}}/slots/{{slotId}}/unblock"
          }
        }
      ]
    },
    {
      "name": "Bookings and payments",
      "item": [
        {
          "name": "Book slot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/book-slot/"
          }
        },
        {
          "name": "Pay booking slot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/book-slot/pay-slot"
          }
        },
        {
          "name": "Cancel booking slot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/book-slot/cancel-slot"
          }
        },
        {
          "name": "Payment callback",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/book-slot/payment/callback?paymentID={{paymentID}}&status={{paymentStatus}}"
          }
        }
      ]
    },
    {
      "name": "Payouts",
      "item": [
        {
          "name": "Owner balance",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payout/balance"
          }
        },
        {
          "name": "Request payout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/payout/request"
          }
        },
        {
          "name": "My payouts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ownerToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payout/my"
          }
        },
        {
          "name": "All payouts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payout/"
          }
        },
        {
          "name": "Approve payout",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payout/{{payoutId}}/approve"
          }
        },
        {
          "name": "Mark payout paid",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payout/{{payoutId}}/pay"
          }
        }
      ]
    }
  ]
}
